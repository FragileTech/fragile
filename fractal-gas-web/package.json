{
  "name": "fractal-control-laboratory",
  "private": true,
  "type": "module",
  "scripts": {
    "test:arcade-browser": "node tests/arcade-planners-browser.mjs",
    "capture:arcade-docs": "node tools/capture-arcade-docs.mjs",
    "test:visual-cohesion-browser": "node tests/visual-cohesion-browser.mjs",
    "test:lab-live-rewards": "node tests/control-live-rewards.test.mjs",
    "test:lab-live-rewards-browser": "node tests/control-live-rewards-browser.mjs",
    "build:lab": "node tools/build-lab.mjs",
    "test:lab": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:lab-mining": "node tests/control-mining-defaults.mjs",
    "test:lab-vehicles": "node tests/control-vehicles-browser.mjs",
    "test:lab-camera": "node tests/control-camera-browser.mjs",
    "test:lab-docs": "node tests/control-doc-examples.test.mjs",
    "capture:lab-docs": "node tools/capture-lab-docs.mjs",
    "test:lab-animations": "node tests/control-animation-browser.mjs && node tests/control-animation-controls-browser.mjs",
    "test:lab-action-guides": "node tests/control-action-guides-browser.mjs",
    "test:lab-action-readability": "node tests/control-action-readability-browser.mjs",
    "test:lab-workspace": "node --test tests/control-workspace.test.mjs && node tests/control-workspace-browser.mjs",
    "build:optimization": "node tools/build-optimization.mjs",
    "test:optimization": "node --test tests/optimization/*.test.mjs",
    "test:optimization-browser": "node tests/optimization/browser.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "prettier": "3.6.2"
  }
}
